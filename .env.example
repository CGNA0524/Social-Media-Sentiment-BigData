# Social Media Sentiment Analysis - Environment Configuration Template
# Copy this file to .env and configure local values as needed

# MongoDB NoSQL Connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sentiment_analytics_db

# Computational Mode Configuration
ENABLE_DISTRIBUTED_SPARK=false
SPARK_MASTER=local[*]

# Random Seed for Reproducibility
RANDOM_SEED=42

# Application Server Port
STREAMLIT_SERVER_PORT=8501

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=social_media_sentiment
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_API_KEY=

# Apache Flink Configuration
FLINK_JOBMANAGER_HOST=localhost
FLINK_JOBMANAGER_PORT=8081
FLINK_STREAM_SOURCE_RATE_MS=500

# Apache Airflow Configuration
AIRFLOW_HOME=C:/Users/NC/Desktop/Social-Media-Sentiment-BigData/orchestration/airflow
AIRFLOW_BATCH_SIZE=50

# Transformer Models Configuration
BERT_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
ROBERTA_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest
TRANSFORMER_DEVICE=cpu
